PORT=5000

# DB_MODE=mock  -> local JSON file store (backend/data/users.json), no Atlas needed
# DB_MODE=mongo -> use MONGO_URI below
DB_MODE=mock
MONGO_URI=

# From @BotFather
TELEGRAM_BOT_TOKEN=

# Numeric id of the channel, e.g. -1001234567890.
# Add the bot as admin, then run: npm run chat-id
CHANNEL_ID=

# true  -> user must share their contact in the bot (mobile app only)
# false -> registration verifies the phone by OTP on the website instead
REQUIRE_PHONE_VERIFICATION=false

# Minutes before expiry to warn the subscriber. 1440 = 1 day.
# Capped per-user at 25% of the plan length.
EXPIRY_WARNING_MINUTES=1440

# SMS for phone verification. Leave blank and the OTP is shown on screen and
# logged to the console instead of being texted - fine for testing.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
